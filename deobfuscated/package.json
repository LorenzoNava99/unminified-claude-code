{
  "name": "claude-code-deobfuscated",
  "version": "2.0.37",
  "description": "Deobfuscated and readable version of Claude Code CLI",
  "main": "deobfuscated.js",
  "type": "module",
  "engines": {
    "node": ">=15.0.0"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage",
    "validate": "node work/validate-transformations.js"
  },
  "dependencies": {
    "localforage": "^1.10.0",
    "axios": "^1.6.2",
    "zod": "^3.22.4",
    "@aws-sdk/signature-v4": "^3.450.0",
    "@aws-sdk/client-bedrock": "^3.840.0",
    "@aws-sdk/client-bedrock-runtime": "^3.797.0",
    "commander": "^9.15.1",
    "react": "^18.3.1",
    "react-reconciler": "^0.29.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/core": "^1.21.0",
    "@opentelemetry/resources": "^1.21.0",
    "@opentelemetry/sdk-metrics": "^1.21.0",
    "@opentelemetry/sdk-trace-base": "^1.21.0",
    "@opentelemetry/sdk-trace-node": "^1.21.0",
    "@opentelemetry/semantic-conventions": "^1.21.0",
    "semver": "^7.5.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prettier": "^3.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "extensionsToTreatAsEsm": [".js"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
