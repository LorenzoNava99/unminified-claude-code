{
  "name": "claude-code-deobfuscated",
  "version": "2.0.37",
  "description": "Deobfuscated and readable version of Claude Code CLI",
  "main": "deobfuscated.js",
  "type": "module",
  "engines": {
    "node": ">=15.0.0"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage",
    "validate": "node work/validate-transformations.js"
  },
  "dependencies": {
    "zod": "^3.23.0",
    "axios": "1.8.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prettier": "^3.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "extensionsToTreatAsEsm": [".js"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
